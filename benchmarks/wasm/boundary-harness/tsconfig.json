{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": ["@playwright/test", "node", "vite/client"]
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "vite.config.ts", "web/**/*.ts"]
}
